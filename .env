# Activar mocks (MSW) en todos los entornos hasta conectar Dataverse
VITE_USE_MOCKS=true

# Client ID del App Registration en Azure AD (Entra ID) — mismo para DEV/TEST/PROD
VITE_DV_CLIENT_ID=1571fa52-83d8-4093-ad3a-b8da89c1356c

# URL del org Dataverse para desarrollo local con pac code run (datos reales).
