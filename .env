# a partir del environmentId de la URL — ver ENV_ORG_MAP en dataverseBridge.ts.
#
# DEV:  https://org4e3f8413.crm4.dynamics.com  (env: 8d4eb458-70b4-e902-ad69-15739a4e304d)
# TEST: https://org50ae1344.crm4.dynamics.com  (env: b1b69beb-b38e-e818-ae23-969e19a24649)
# PROD: https://org14370965.crm4.dynamics.com  (env: 0d305ae7-7841-e70a-8f6e-f5e2f59a9448)
VITE_DV_ORG_URL=https://org4e3f8413.crm4.dynamics.com